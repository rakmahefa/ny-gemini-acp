{
  "name": "ny-gemini-acp",
  "image": "mcr.microsoft.com/devcontainers/rust:bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.82"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "CODESPACE_REPOSITORY": "rakmahefa/ny-gemini-acp"
  },
  "secrets": {
    "CODESPACE_RUNNER_PAT": {
      "description": "GitHub token with repository Actions administration write permission, used only to register the Codespace as a self-hosted Actions runner.",
      "documentationUrl": "https://docs.github.com/en/actions/hosting-your-own-runners/managing-self-hosted-runners/adding-self-hosted-runners"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  },
  "postCreateCommand": "rustup component add rustfmt clippy",
  "postStartCommand": "bash .devcontainer/setup-codespace-runner.sh"
}
